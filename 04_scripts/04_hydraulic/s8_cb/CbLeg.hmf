<?xml version='1.0' encoding='utf-8'?>
<hopsanmodelfile hmfversion="0.4" hopsanguiversion="2.24.4" hopsancoreversion="2.24.4">
  <requirements>
    <componentlibrary>HopsanDefaultComponentLibrary</componentlibrary>
  </requirements>
  <system typename="Subsystem" name="CbLeg">
    <simulationtime start="0.0" timestep="1e-05" stop="6.0" inherit_timestep="true" />
    <simulationlogsettings numsamples="6001" starttime="0.0" />
    <parameters />
    <objects>
      <component typename="HydraulicTankC" name="Tank">
        <parameters>
          <parameter name="p" value="100000" type="double" unit="Pa" />
        </parameters>
      </component>
      <component typename="HydraulicTankC" name="Tank2">
        <parameters>
          <parameter name="p" value="100000" type="double" unit="Pa" />
        </parameters>
      </component>
      <component typename="HydraulicTurbulentOrifice" name="OrfR">
        <parameters>
          <parameter name="A#Value" value="0.0001" type="double" unit="m^2" />
        </parameters>
      </component>
      <component typename="HydraulicCylinderC" name="Cyl">
        <parameters>
          <parameter name="A_1#Value" value="0.013273229" type="double" unit="m^2" />
          <parameter name="A_2#Value" value="0.00376991118" type="double" unit="m^2" />
          <parameter name="s_l#Value" value="0.7" type="double" unit="m" />
          <parameter name="V_1#Value" value="0.0053092916" type="double" unit="m^3" />
          <parameter name="V_2#Value" value="0.0013194689" type="double" unit="m^3" />
          <parameter name="B_p#Value" value="33900" type="double" unit="Ns/m" />
          <parameter name="Beta_e#Value" value="1000000000" type="double" unit="Pa" />
          <parameter name="c_leak#Value" value="0" type="double" unit="(m^3/s)/Pa" />
          <parameter name="use_sl" value="false" type="bool" />
        </parameters>
      </component>
      <component typename="HydraulicPressureReliefValve" name="CB">
        <parameters>
          <parameter name="p_max#Value" value="33100000" type="double" unit="Pa" />
          <parameter name="tao#Value" value="0.01" type="double" unit="s" />
          <parameter name="p_h#Value" value="0" type="double" unit="Pa" />
          <parameter name="k_cs" value="2.236e-10" type="double" unit="(m^3/s)/Pa" />
          <parameter name="k_cf" value="1000" type="double" unit="(m^3/s)/Pa" />
          <parameter name="q_nom" value="0.01" type="double" unit="m^3/s" />
        </parameters>
      </component>
      <component typename="MechanicTranslationalMass" name="Mass">
        <parameters>
          <parameter name="m" value="9690" type="double" unit="kg" />
          <parameter name="B#Value" value="0" type="double" unit="Ns/m" />
          <parameter name="k#Value" value="4770000" type="double" unit="N/m" />
        </parameters>
      </component>
      <component typename="MechanicForceTransformer" name="Load">
        <parameters />
      </component>
      <component typename="SignalRamp" name="R1">
        <parameters>
          <parameter name="y_0#Value" value="0" type="double" />
          <parameter name="y_A#Value" value="116300" type="double" />
          <parameter name="t_start#Value" value="0" type="double" unit="s" />
          <parameter name="t_end#Value" value="1" type="double" unit="s" />
        </parameters>
      </component>
      <component typename="SignalRamp" name="R2">
        <parameters>
          <parameter name="y_0#Value" value="0" type="double" />
          <parameter name="y_A#Value" value="383700" type="double" />
          <parameter name="t_start#Value" value="2" type="double" unit="s" />
          <parameter name="t_end#Value" value="4" type="double" unit="s" />
        </parameters>
      </component>
      <component typename="SignalAdd" name="Add">
        <parameters />
      </component>
    </objects>
    <connections>
      <connect startcomponent="Cyl" startport="P1" endcomponent="CB" endport="P1" />
      <connect startcomponent="CB" startport="P2" endcomponent="Tank" endport="P1" />
      <connect startcomponent="Cyl" startport="P2" endcomponent="OrfR" endport="P1" />
      <connect startcomponent="OrfR" startport="P2" endcomponent="Tank2" endport="P1" />
      <connect startcomponent="Cyl" startport="P3" endcomponent="Mass" endport="P1" />
      <connect startcomponent="Mass" startport="P2" endcomponent="Load" endport="P1" />
      <connect startcomponent="R1" startport="out" endcomponent="Add" endport="in1" />
      <connect startcomponent="R2" startport="out" endcomponent="Add" endport="in2" />
      <connect startcomponent="Add" startport="out" endcomponent="Load" endport="F" />
    </connections>
  </system>
</hopsanmodelfile>