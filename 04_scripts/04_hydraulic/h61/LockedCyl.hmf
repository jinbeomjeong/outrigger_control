<?xml version='1.0' encoding='utf-8'?>
<hopsanmodelfile hmfversion="0.4" hopsancoreversion="2.24.4">
  <requirements>
    <componentlibrary>HopsanDefaultComponentLibrary</componentlibrary>
  </requirements>
  <system typename="Subsystem" name="LockedCyl">
    <simulationtime start="0.0" timestep="1e-05" stop="2.0" inherit_timestep="true" />
    <simulationlogsettings numsamples="2001" starttime="0.0" />
    <parameters />
    <objects>
      <component typename="HydraulicCylinderC" name="Cyl">
        <parameters>
          <parameter name="A_1#Value" value="0.013273229" type="double" unit="m^2" />
          <parameter name="A_2#Value" value="0.00376991118" type="double" unit="m^2" />
          <parameter name="s_l#Value" value="0.001" type="double" unit="m" />
          <parameter name="V_1#Value" value="0.0094107" type="double" unit="m^3" />
          <parameter name="V_2#Value" value="0.00034306" type="double" unit="m^3" />
          <parameter name="B_p#Value" value="34403.5" type="double" unit="Ns/m" />
          <parameter name="Beta_e#Value" value="1000000000" type="double" unit="Pa" />
          <parameter name="c_leak#Value" value="0" type="double" unit="(m^3/s)/Pa" />
          <parameter name="use_sl" value="false" type="bool" />
          <parameter name="P1#Pressure" value="9100000" type="double" unit="Pa" />
          <parameter name="P2#Pressure" value="2100000" type="double" unit="Pa" />
        </parameters>
      </component>
      <component typename="HydraulicTurbulentOrifice" name="OrfH">
        <parameters>
          <parameter name="A#Value" value="0" type="double" unit="m^2" />
        </parameters>
      </component>
      <component typename="HydraulicTurbulentOrifice" name="OrfR">
        <parameters>
          <parameter name="A#Value" value="0" type="double" unit="m^2" />
        </parameters>
      </component>
      <component typename="HydraulicTankC" name="TankH">
        <parameters>
          <parameter name="p" value="100000" type="double" unit="Pa" />
        </parameters>
      </component>
      <component typename="HydraulicTankC" name="TankR">
        <parameters>
          <parameter name="p" value="100000" type="double" unit="Pa" />
        </parameters>
      </component>
      <component typename="MechanicTranslationalMass" name="Mass">
        <parameters>
          <parameter name="m" value="10000" type="double" unit="kg" />
          <parameter name="B#Value" value="0" type="double" unit="Ns/m" />
        </parameters>
      </component>
      <component typename="MechanicForceTransformer" name="Load">
        <parameters />
      </component>
      <component typename="SignalRamp" name="Ramp">
        <parameters>
          <parameter name="y_0#Value" value="112867" type="double" />
          <parameter name="y_A#Value" value="-25000" type="double" />
          <parameter name="t_start#Value" value="0.5" type="double" unit="s" />
          <parameter name="t_end#Value" value="0.55" type="double" unit="s" />
        </parameters>
      </component>
    </objects>
    <connections>
      <connect startcomponent="Cyl" startport="P1" endcomponent="OrfH" endport="P1" />
      <connect startcomponent="OrfH" startport="P2" endcomponent="TankH" endport="P1" />
      <connect startcomponent="Cyl" startport="P2" endcomponent="OrfR" endport="P1" />
      <connect startcomponent="OrfR" startport="P2" endcomponent="TankR" endport="P1" />
      <connect startcomponent="Cyl" startport="P3" endcomponent="Mass" endport="P1" />
      <connect startcomponent="Mass" startport="P2" endcomponent="Load" endport="P1" />
      <connect startcomponent="Ramp" startport="out" endcomponent="Load" endport="F" />
    </connections>
  </system>
</hopsanmodelfile>